# mini-dae systemd 单元（由 install/install.sh 安装到 /etc/systemd/system/dae-mini.service）。
#
# ExecStart 参数说明：
#   --config /etc/dae-mini/config.dae       完整 dae 配置（安装脚本从 lab/gateway.dae 拷贝样例）
#   --ebpf   /usr/lib/dae-mini/mini-dae-ebpf  Rust/aya eBPF 数据面对象
#
# 注意（部署前必读，详见 docs/deploy.md）：
#   - 这是最小骨架：不带节点/订阅参数，需要用户用 `systemctl edit dae-mini`（drop-in）
#     追加 --dialer '<节点URL>' 或 --subscribe file:///etc/dae-mini/sub.url --group proxy；
#     样例 dns.routing 用到 geosite，还需要 geosite.dat/geoip.dat（放 /etc/dae-mini/ 或
#     --geodata-dir），否则加载器会在编译 dns.routing 时退出。
#   - loader 不会自行创建 netns/veth/sysctl；默认接口/命名是
#     --lan landae --wan wan --daens daens --dae0 dae0 --dae0peer dae0peer。
#     真机网关（对照 lab/gateway.sh）应通过 drop-in 补齐，例如：
#       [Service]
#       ExecStart=
#       ExecStart=/usr/local/bin/mini-dae --config /etc/dae-mini/config.dae \
#           --ebpf /usr/lib/dae-mini/mini-dae-ebpf \
#           --lan none --wan wlan0 \
#           --daens gwdae --dae0 dae0gw --dae0peer dae0gwpeer \
#           --dialer 'anytls://…'      # 或：
#           --subscribe file:///etc/dae-mini/sub.url --group proxy
#       # 可选状态面（放 /run 下，和下面的 RuntimeDirectory 配套；默认客户端路径是
#       # /tmp/mini-dae-status.sock，服务端只有传 --status-socket 才创建）：
#       # --status-socket /run/dae-mini/status.sock
#     并在 drop-in 里一并加：
#       RuntimeDirectory=dae-mini
#       RuntimeDirectoryMode=0750
#   - systemd 单元里 URL 的 `%` 必须写成 `%%`；把订阅 URL 放进文件（chmod 600）可避免。
#
# SIGHUP = 重读 --config/--rules 热重载 + reopen --log-file（对照 dae reload）。

[Unit]
Description=mini-dae transparent proxy gateway (eBPF datapath)
Documentation=https://github.com/zhanghuanhuan303/dae-rust/blob/main/docs/deploy.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/mini-dae --config /etc/dae-mini/config.dae --ebpf /usr/lib/dae-mini/mini-dae-ebpf

# SIGHUP = 热重载（等价 mini-dae reload）；systemctl reload dae-mini 触发。
ExecReload=/bin/kill -HUP $MAINPID

Restart=on-failure
RestartSec=3

# 加载 eBPF（CAP_BPF）、tc/tproxy/网络配置（CAP_NET_ADMIN）、setns/挂载等（CAP_SYS_ADMIN）。
AmbientCapabilities=CAP_BPF CAP_NET_ADMIN CAP_SYS_ADMIN
CapabilityBoundingSet=CAP_BPF CAP_NET_ADMIN CAP_SYS_ADMIN

# relay/连接多时的 fd 上限。
LimitNOFILE=1048576

# 可选：把状态面 socket 放 /run 下时取消注释（与 ExecStart 的 --status-socket 配套）。
# RuntimeDirectory=dae-mini
# RuntimeDirectoryMode=0750

[Install]
WantedBy=multi-user.target
