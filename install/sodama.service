# sodama systemd 单元（由 install/install.sh 安装到 /etc/systemd/system/sodama.service）。
#
# ExecStart 参数说明：
#   --config /etc/sodama/config.dae       完整 dae 配置（安装脚本从 lab/gateway.dae 拷贝样例）
#   --ebpf   /usr/lib/sodama/sodama-ebpf  Rust/aya eBPF 数据面对象
#
# 注意（部署前必读，详见 docs/deploy.md）：
#   - 这是最小骨架：不带节点/订阅参数，需要用户用 `systemctl edit sodama`（drop-in）
#     追加 --dialer '<节点URL>' 或 --subscribe file:///etc/sodama/sub.url --group proxy；
#     样例 dns.routing 用到 geosite，还需要 geosite.dat/geoip.dat（放 /etc/sodama/ 或
#     --geodata-dir），否则加载器会在编译 dns.routing 时退出。
#   - loader 不会自行创建 netns/veth/sysctl；默认接口/命名是
#     --lan landae --wan wan --daens daens --dae0 dae0 --dae0peer dae0peer。
#     真机网关（对照 lab/gateway.sh）应通过 drop-in 补齐，例如：
#       [Service]
#       ExecStart=
#       ExecStart=/usr/local/bin/sodama --config /etc/sodama/config.dae \
#           --ebpf /usr/lib/sodama/sodama-ebpf \
#           --lan none --wan wlan0 \
#           --daens gwdae --dae0 dae0gw --dae0peer dae0gwpeer \
#           --dialer 'anytls://…'      # 或：
#           --subscribe file:///etc/sodama/sub.url --group proxy
#       # 可选状态面（放 /run 下，和下面的 RuntimeDirectory 配套；默认客户端路径是
#       # /tmp/sodama-status.sock，服务端只有传 --status-socket 才创建）：
#       # --status-socket /run/sodama/status.sock
#     并在 drop-in 里一并加：
#       RuntimeDirectory=sodama
#       RuntimeDirectoryMode=0750
#   - systemd 单元里 URL 的 `%` 必须写成 `%%`；把订阅 URL 放进文件（chmod 600）可避免。
#   - A2 #18：`ExecStartPre` 用 `validate` 做启动前配置门禁（同 dae：只读本地资产、
#     不加载 eBPF/不联网）；`Type=notify` 依赖进程的 sd_notify("READY=1")
#     （`main.rs::sd_notify`，无 systemd 时 no-op；用单元时请确保命令不丢 NOTIFY_SOCKET）。
#     若你的 drop-in 覆盖了 ExecStart 且不希望 notify 语义，把 Type= 改回 simple 即可。
#
# SIGHUP = 重读 --config/--rules 热重载 + reopen --log-file（对照 dae reload）。

[Unit]
Description=sodama transparent proxy gateway (eBPF datapath)
Documentation=https://github.com/zhanghuanhuan303/dae-rust/blob/main/docs/deploy.md
After=network-online.target systemd-sysctl.service
Wants=network-online.target
# 崩溃环熔断：5 分钟内 5 次重启后放弃（对照 dae `StartLimitIntervalSec=300/StartLimitBurst=5`）。
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=notify
ExecStartPre=/usr/local/bin/sodama validate /etc/sodama/config.dae
ExecStart=/usr/local/bin/sodama --config /etc/sodama/config.dae --ebpf /usr/lib/sodama/sodama-ebpf

# SIGHUP = 热重载（等价 sodama reload）；systemctl reload sodama 触发。
ExecReload=/bin/kill -HUP $MAINPID

# 重启策略：on-abnormal 让「配置被拒」（ExecStartPre 非零退出）不无限重试；
# 突发上限再兜一层（对照 dae `Restart=on-abnormal`）。
Restart=on-abnormal
RestartSec=5s

# 启动/停止超时（对照 dae TimeoutStartSec=120）：启动含订阅拉取与资产展开。
TimeoutStartSec=120
TimeoutStopSec=30

# 降低被 OOM kill 的优先级（对照 dae `OOMScoreAdjust=-100`）。
OOMScoreAdjust=-100

# 加载 eBPF（CAP_BPF）、tc/tproxy/网络配置（CAP_NET_ADMIN）、setns/挂载等（CAP_SYS_ADMIN）。
AmbientCapabilities=CAP_BPF CAP_NET_ADMIN CAP_SYS_ADMIN
CapabilityBoundingSet=CAP_BPF CAP_NET_ADMIN CAP_SYS_ADMIN

# relay/连接多时的 fd 上限；订阅并发与线程池的进程上限（对照 dae LimitNPROC）。
LimitNOFILE=1048576
LimitNPROC=4096

# 可选：把状态面 socket 放 /run 下时取消注释（与 ExecStart 的 --status-socket 配套）。
# RuntimeDirectory=sodama
# RuntimeDirectoryMode=0750

[Install]
WantedBy=multi-user.target
