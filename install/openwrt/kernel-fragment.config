# sodama on OpenWrt —— 内核配置要求（Linux >= 6.6，OpenWrt >= 24.10）
#
# 用法（OpenWrt buildroot）：
#   make kernel_menuconfig   # 对照勾选/核对
#   或把本文件追加到 target/linux/<target>/config-<ver> 之后（追加行会覆盖默认）
#
# 说明：
# - 挂载走 TCX（bpf_link），需要内核 6.6+；OpenWrt 23.05（5.15）不支持。
# - CONFIG_DEBUG_INFO_BTF 非必需（当前 eBPF 程序不使用 CO-RE），
#   但建议开启：bpftool/调试、未来 CO-RE 与 BTF map 诊断都依赖它。
# - 带 (auto) 的项通常由依赖自动选中，列出便于核对。

# eBPF 基础设施
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_DEBUG_INFO_BTF=y          # 建议（非必需）

# TC/TCX 数据面
CONFIG_NET_CLS_ACT=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_ACT_BPF=y
CONFIG_NET_XGRESS=y              # (auto) TCX 基础（6.6+）

# sockmap / offload / UDP 批量
CONFIG_NET_SOCK_MSG=y            # (auto)
CONFIG_BPF_STREAM_PARSER=y

# cgroup2（pname 进程名分流；缺失时功能自动降级）
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y

# netns / veth（控制面对）
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
CONFIG_VETH=y                    # 或内核模块 kmod-veth

# 转发与策略路由
CONFIG_IP_ADVANCED_ROUTER=y      # (auto) 策略路由（fwmark 本地投递）
CONFIG_IP_MULTIPLE_TABLES=y      # (auto)
