# sodama 示例配置（dae 语法）——OpenWrt 上放到 /etc/sodama/config.dae。
# 出口用任意 dae 语法可表达的节点：vless/vmess/trojan/ss/ssr/socks5/hysteria2/tuic...
# 也可以改用订阅：加 --subscribe <url>（procd 场景可写 subscription 段；详见 docs/openwrt.md）。
#
# 注意权限：dae 要求配置文件同组不可写、其他用户不可读（mode & 0o037 == 0），
# 因此安装后请保持 0640/0600（本包 INSTALL_CONF 已按 0600 安装）。
global {
    wan_interface: wan
    lan_interface: br-lan
    tproxy_port: 12345
    log_level: info
    auto_config_kernel_parameter: true
    tcp_check_url: 'http://www.gstatic.com/generate_204'
    check_interval: 10s
}

node {
    # 示例：本机/上游 socks5 出口；替换成你的 vless/vmess/… 节点即可
    my: 'socks5://127.0.0.1:1080'
}

group {
    proxy {
        policy: min_moving_avg
        filter: name(my)
    }
}

routing {
    fallback: proxy
}
