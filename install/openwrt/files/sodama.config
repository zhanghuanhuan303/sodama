config sodama 'main'
	# 0 = 安装后不自动启动；置 1 启用
	option enabled '0'

	# dae 语法完整配置（含 node/subscription/routing）
	option config '/etc/sodama/config.dae'

	# 主路由模式：留空 lan（等价 --lan none，WAN 出口钩子接管本机+转发流量）
	# 需要额外 LAN ingress 钩子时填 'br-lan'
	option lan ''

	# WAN 出口接口（PPPoE 一般是 pppoe-wan）
	option wan 'wan'

	# 单臂旁路由模式：填 LAN 口（如 'br-lan'），与 lan/wan 搭配使用
	# option dual 'br-lan'

	option daens 'daens'
	option dae0 'dae0'
	option dae0peer 'dae0peer'

	option status_socket '/var/run/sodama.sock'
	option log_file '/var/log/sodama.log'

	# 可选：TCP relay offload（内核对拼）
	option offload '0'

	# 拨号/嗅探参数
	option dial_timeout '15'
	option dial_mode 'ip'
	option sniffing_timeout_ms '100'
	option ipv6 '1'
