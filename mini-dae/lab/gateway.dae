# P18 真网关配置（--config 模式）：分流转发纪律同 rules.gateway.dae，
# 外加：宿主机 DNS 进入控制面 → 加密上游（DoH，可切 DoQ）+ dns.routing（广告域 reject）。
#
# 用法：
#   sudo lab/gateway.sh up --config lab/gateway.dae --geodata-dir /usr/share/v2ray \
#        --subscribe /tmp/mini-dae-sub.url
#   （--dns <URL> 可显式覆盖上游；缺省用本文件 dns.upstream/dns.routing）
#
# 注意（对照 rules.gateway.dae 的踩坑注释）：
# - 与 rules.gateway.dae 的唯一策略差异：**去掉** `dport(53) -> direct(must)`，
#   让宿主机 DNS 查询进控制面，由本文件 dns.upstream/dns.routing 决定去向。
# - 不要再加回 dport(53) 的 must 规则，否则 DNS 回到直连、本文件 dns 段不参与。
# - 别写任何 `sip(...)` 规则（宿主机模式下源地址都是本机地址）。
# - DoH 上游用 IP 字面量 + `?sni=`：避免“解析上游域名又需要 DNS”的鸡生蛋
#   （不依赖 bootstrap_resolver）；`quic://` DoQ 用域名（启动时经系统解析一次）。
# - geosite 需要 `--geodata-dir`（或 DAE_LOCATION_ASSET）指向 v2ray .dat 目录。
# - 控制面自己的上游查询走 marked socket（SO_MARK），不会回流数据面。

global {
    dial_mode: 'domain'
}

dns {
    upstream {
        # 主：AliDNS DoH（TCP 443，IP 字面量 + SNI，公网证书校验）
        alidns: 'https://223.5.5.5/dns-query?sni=dns.alidns.com'
        # 同上 + ECS（mini 扩展：auto = 按查询发起方地址归整 v4 /24、v6 /56）——
        # 国内域用它，让 CDN 解析落到本地视角（不再依赖路由器明文）
        alidns_ecs: 'https://223.5.5.5/dns-query?sni=dns.alidns.com&ecs=auto'
        # 备选其一：DoQ（RFC 9250，UDP 853，本网络实测可用）
        ali_quic: 'quic://dns.alidns.com'
        # 备选：本地路由器明文（调试对照；也可作为 geosite:cn 的出口）
        router: 'udp://192.0.2.1:53'
    }
    routing {
        request {
            # 1) 广告/跟踪域：geosite 数据集
            qname(geosite:category-ads-all) -> reject
            # 2) 自定义拦截名单（每行一条；相对路径按本文件目录解析）
            qname(file: 'blocklist.txt') -> reject
            # 3) 国内域：DoH + ECS（客户端子网），CDN 解析准；
            #   想改回本地明文路由器就换成 router
            qname(geosite:cn) -> alidns_ecs
            # 4) 其余（海外）走普通 DoH；想全局 DoQ 就把下面换成 ali_quic
            fallback: alidns
        }
        response {
            fallback: accept
        }
    }
}

routing {
    # --- 私网/特殊地址（目的）：直连 ---
    dip(192.168.0.0/16) -> direct
    dip(10.0.0.0/8) -> direct
    dip(172.16.0.0/12) -> direct
    dip(169.254.0.0/16) -> direct
    dip(224.0.0.0/4) -> direct
    dip(240.0.0.0/4) -> direct
    dip(255.255.255.255/32) -> direct
    dip('fe80::/10') -> direct
    dip('fc00::/7') -> direct
    dip('ff00::/8') -> direct

    # --- QUIC：阻断 UDP/443，浏览器回落 TCP ---
    l4proto(udp) && dport(443) -> block

    # --- 其余 UDP：直连（暂不做 UDP 代理） ---
    l4proto(udp) -> direct

    # --- pname：命令行调试工具直连（浏览器等不受影响，走 fallback -> proxy） ---
    pname(curl) -> direct
    pname(python3) -> direct

    # --- 兜底：全部 TCP 走代理（--config 模式的 routing 段用 `key: value` 形式） ---
    fallback: proxy
}
