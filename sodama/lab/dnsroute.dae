# P18c：dns.routing 请求/应答分流（对照 dae docs/en/configuration/dns.md 示例形态）。
#
# - request：qname/qtype → reject / asis / tag（up1/up2）
# - response：upstream/ip → accept / reject / tag（换上游重查）
# - fallback：request=up1（本实验不用 asis 默认以免出网）、response=accept
#
# 路由段沿用 rules.dns.dae：fallback -> proxy 让 dport 53 进控制面（透明 DNS）。
global {
    dial_mode: 'ip'
}

dns {
    upstream {
        up1: 'udp://127.0.0.1:5353'
        up2: 'udp://127.0.0.1:5354'
        # sodama 扩展：注入 ECS（auto = 按查询发起方地址归整 v4 /24、v6 /56）
        up2ecs: 'udp://127.0.0.1:5354?ecs=auto'
    }
    routing {
        request {
            qname(full: blocked.test) -> reject
            qname(file: 'blocklist.test.txt') -> reject
            qname(suffix: via2.test) -> up2
            qname(suffix: ecsroute.test) -> up2ecs
            qtype(https) -> reject
            qname(suffix: asis.test) -> asis
            # sodama 扩展：按客户端源网段分流
            qname(suffix: viacli.test) && sip(10.0.0.0/24) -> up2
            fallback: up1
        }
        response {
            upstream(up2) -> accept
            ip(10.9.10.60/32) -> reject
            ip(10.9.10.61/32) -> up2
            # sodama 扩展：应答侧按客户端来源过滤（先匹配 10.9.9.0/24——实验客户端
            # 10.0.0.2 不在其中，应跳过；再命中 10.0.0.0/24 → 空应答）
            sip(10.9.9.0/24) && ip(10.9.10.62/32) -> reject
            sip(10.0.0.0/24) && ip(10.9.10.62/32) -> reject
            fallback: accept
        }
    }
}

routing {
    dport(5353) -> direct(must)
    domain(suffix: 'proxy.test') && dport(9999) -> proxy
    domain(full: 'direct.test') && dport(9999) -> direct
    fallback: proxy
}
