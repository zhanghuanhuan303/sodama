post_install() {
  cat <<'EOF'
:: 下一步：
   1) 编辑 /etc/sodama/config.dae：wan_interface/lan_interface 改成实际网卡，
      并在 node{} 或 subscription{} 填入你的节点/订阅；
   2) sudo chmod 640 /etc/sodama/config.dae
   3) sudo sodama validate /etc/sodama/config.dae
   4) sudo systemctl enable --now sodama
   5) （可选）sudo systemctl enable --now sodama-panel  → http://127.0.0.1:8080（默认仅本机）
   详见 /usr/share/doc/sodama/README.md
EOF
}

post_upgrade() {
  post_install
}

pre_remove() {
  cat <<'EOF'
:: 提示：已停止的服务与数据面拓扑不会自动清理；
   sudo systemctl disable --now sodama-panel sodama
   sudo /usr/lib/sodama/datapath teardown
   配置与日志保留在 /etc/sodama、/etc/sodama-panel、/var/log/sodama.log*
EOF
}
