# Maintainer: sodama <sodama@example.com>
#
# 二进制包：从 GitHub Release 安装预编译产物（musl 静态，含 Web 面板）。
# 发布 tarball 由仓库 `packaging/make-release.sh` 生成（同仓 src，可复现）。

pkgname=sodama-bin
pkgver=1.0.0
pkgrel=3
pkgdesc="Transparent proxy gateway with a Rust eBPF datapath (dae rewrite) — prebuilt"
arch=('x86_64')
url="https://github.com/zhanghuanhuan303/sodama"
license=('AGPL-3.0-only')
depends=('iproute2' 'procps-ng' 'sh')
optdepends=(
  'bpftool: 数据面排查（bpftool net show / prog show）'
  'nftables: 防火墙示例'
)
provides=('sodama')
conflicts=('sodama')
backup=('etc/sodama/config.dae' 'etc/sodama/config-gateway.dae' 'etc/sodama/sodama.conf'
        'etc/sodama/blocklist.txt' 'etc/sodama/rules/cn_direct.txt' 'etc/sodama/rules/user_proxy.txt'
        'etc/sodama/rules/user_direct.txt' 'etc/sodama-panel/panel.conf')
install=sodama-bin.install
# eBPF 对象必须保留 .symtab/.BTF（map 定义与 BTF map 依赖符号）；不 strip、不生成 debug 包。
options=('!debug' '!strip')
source=("sodama-$pkgver-$CARCH.tar.gz::$url/releases/download/v$pkgver/sodama-$pkgver-$CARCH.tar.gz")
# TODO(release): 由 packaging/make-release.sh 重新生成 tarball 后回填 sha256。
sha256sums=('SKIP')

check() {
  cd "$srcdir/sodama-$pkgver-$CARCH"
  # 数据面脚本必须是带 shebang 的可执行脚本（否则 systemd 报 203/EXEC）
  head -1 usr/lib/sodama/datapath | grep -q '^#!' || {
    printf 'sodama: usr/lib/sodama/datapath 缺 shebang\n' >&2
    return 1
  }
  sh -n usr/lib/sodama/datapath || return 1
}

package() {
  cp -a "$srcdir/sodama-$pkgver-$CARCH/." "$pkgdir/"
}
