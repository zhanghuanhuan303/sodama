# sodama 示例配置（dae 语法）——Arch 安装后位于 /etc/sodama/config.dae
#
# 权限要求：同组不可写、其他用户不可读（mode & 0o037 == 0），保持 0640/0600。
# 改完先校验：sudo sodama validate /etc/sodama/config.dae
# 生效：sudo systemctl reload sodama   （SIGHUP 热重载）
#
# 接口名用真实网卡：`ip -br link`；默认路由接口：`ip route show default`。
# 单机代理（本机流量）也可把 lan_interface 写成 none。
global {
    # ↓↓↓ 改成你的实际接口 ↓↓↓
    wan_interface: wan0
    lan_interface: br0
    tproxy_port: 12345
    log_level: info
    # 自动写 ip_forward/forwarding/send_redirects/accept_ra，并在运行中被改回时纠正
    auto_config_kernel_parameter: true
    tcp_check_url: 'http://www.gstatic.com/generate_204'
    check_interval: 10s
}

# 出口节点（任选其一；订阅也可写在 config 里，见 config-doc）：
#   node { my: 'vless://uuid@host:443?security=tls&sni=example.com#node1' }
# 或使用订阅（键 = 标签，值 = 订阅 URL；可声明多个，按顺序回退）：
#   subscription { main: 'https://example.com/sub' }

# DNS（可选）：不写时用内置回退 8.8.8.8:53（部分网络不可达 → 表现为“能 ping 不能上网”）。
# 建议显式指定一个本网可达的上游（下面以 AliDNS DoH 为例，按需改）：
# dns {
#     upstream {
#         alidns: 'https://223.5.5.5/dns-query?sni=dns.alidns.com'
#     }
#     routing {
#         request { fallback: alidns }
#         response { fallback: accept }
#     }
# }
node {
    my: 'socks5://127.0.0.1:1080'
}

group {
    proxy {
        policy: min_moving_avg
        filter: name(my)
    }
}

routing {
    # 注意：引擎要求至少一条「可编译规则」（只写 fallback 会被拒启：
    #       “routing 段没有任何可编译规则”），所以下面这些直连规则不能删光。
    # 私网/链路本地直连：不代理内网与本机自身流量
    dip(192.168.0.0/16) -> direct
    dip(10.0.0.0/8) -> direct
    dip(172.16.0.0/12) -> direct
    dip(169.254.0.0/16) -> direct
    dip('fe80::/10') -> direct
    dip('fc00::/7') -> direct
    # 其余流量走上面的 proxy 组
    fallback: proxy
}
