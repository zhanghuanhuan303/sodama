#!/bin/sh /etc/rc.common
# sodama 控制面板（procd 托管）。
#
# start: 直接拉起面板（无数据面对，无需 setup/teardown）。
# 停止/reload 由 procd 负责。

START=96
STOP=11
USE_PROCD=1

PANEL=/usr/bin/sodama-panel
CONF=/etc/sodama-panel/panel.conf

start_service() {
	[ -x "$PANEL" ] || {
		echo "sodama-panel: 缺 $PANEL（先跑 scripts/deploy.sh）"
		return 1
	}
	procd_open_instance
	procd_set_param command "$PANEL" --config "$CONF"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
	echo "sodama-panel: 启动（$CONF）"
}
